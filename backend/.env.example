# Copiar a .env y completar. Nunca subir .env al repositorio.
PORT=3000

# Con SUPABASE_URL y SUPABASE_SERVICE_KEY el sistema usa PostgreSQL (Supabase).
# Si se dejan vacíos, arranca en modo demostración con datos en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# JWT del administrador
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=8h

# Solo modo demostración (sin Supabase)
DEMO_ADMIN_EMAIL=jorge_zamora28@outlook.com
DEMO_ADMIN_PASSWORD=minecraft28

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
